    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// 1. 获取当前正在处理的单篇新闻数据（由前驱节点传入）\nconst article = $json;\n\n// 2. 强行拉取所有分类规则\n// 不管前面的节点怎么变，用 $('节点名').all() 可以把规则库里的所有规则一股脑全拿出来\nlet rules = [];\ntry {\n    rules = $('Load Classification Rules').all().map(item => item.json);\n} catch (e) {\n    // 兜底：如果没捞到规则，保持原样输出\n    rules = [];\n}\n\n// 3. 将当前文章的标题和内容转为小写，用于关键词匹配\nconst title = (article.title || '').toLowerCase();\nconst content = (article.content || '').toLowerCase(); // 修正为真实的字段名 content\nconst textToMatch = `${title} ${content}`;\n\nlet matchedRule = null;\n\n// 4. 遍历规则，找到第一个匹配的规则\nfor (const rule of rules) {\n    const keywords = rule.keywords || [];\n    // 检查是否有任意一个关键词被文章包含\n    const hasMatch = keywords.some(keyword => textToMatch.includes(keyword.toLowerCase()));\n    \n    if (hasMatch) {\n        matchedRule = rule;\n        break; // 找到第一个匹配就停止\n    }\n}\n\n// 5. 初始化最终输出的分类和优先级（默认继承 AI 的分析结果）\nlet finalCategory = article.analysis_raw.category_key;\nlet finalPriority = article.analysis_raw.priority;\n\n// 6. 如果触发了本地规则，强行覆盖 AI 的判断（本地规则权重更高）\nif (matchedRule) {\n    finalCategory = matchedRule.category_key;\n    if (matchedRule.priority_override) {\n        finalPriority = matchedRule.priority_override;\n    }\n}\n\n// 7. 返回组装好的新数据，并注入规则引擎的元数据\nreturn {\n    ...article,\n    category_key: finalCategory,\n    priority: finalPriority,\n    sentiment: article.analysis_raw.sentiment,\n    _metadata: {\n        classification_source: matchedRule ? 'rule_engine' : 'ai_only',\n        matched_rule_name: matchedRule ? matchedRule.rule_name : null\n    }\n};"
      },
