    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// 1. 获取当前进入数据库失败分支的单条数据\n// 在 Run for Each Item 模式下，$json 直接就是当前这条失败数据的完整内容\nconst failedItem = $json;\n\n// 2. 尝试从前驱节点抓取真实的数据库报错原因\n// n8n 在节点报错进入 Error 分支时，通常会在数据里注入 error 对象\nconst errorMsg = failedItem.error?.message || 'Unknown database error';\nconst errorNode = failedItem.error?.nodeName || 'Insert rows in a table';\n\n// 3. 直接返回平铺的对象，不要在外层套 json: {}\nreturn {\n    ...failedItem,\n    error_type: 'database_insertion_failed',\n    error_message: errorMsg,\n    error_node: errorNode,\n    retry_needed: true,\n    failed_at: new Date().toISOString(),\n    \n    // 监控元数据\n    _metadata: {\n        processing_stage: 'db_error_handled',\n        severity: 'high',\n        requires_immediate_attention: true\n    }\n};"
      },
