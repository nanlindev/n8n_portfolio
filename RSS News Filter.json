    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// 1. 获取当前进入失败分支的单条数据（由 HTTP Request 的 Error 分支传入）\nconst currentItem = $json;\n\n// 2. 获取对应的原始 RSS 数据\nlet rssData = {};\ntry {\n    rssData = $('RSS Data Cleaner').item.json;\n} catch (e) {\n    // 🛡️ 极端防崩：万一获取前驱节点失败，用当前节点兜底\n    rssData = currentItem;\n}\n\n// 3. 生成完美的降级/报错数据结构，把下游可能访问的字段全部“垫平”\nreturn {\n    source_url: rssData.url || rssData.source_url || '',\n    title: rssData.title || 'Untitled News',\n    content: rssData.content || '',\n    category_key: 'error_requires_review', // 标记需要人工审核\n    sentiment: 'unknown',\n    priority: 'low', // 降级数据默认给低优先级，防止误触发通知\n\n    // 💡 核心：完美补齐下游分类和入库节点需要的完整树状结构\n    analysis_result: {\n        error: currentItem.message || currentItem.error || 'AI service unavailable or timeout',\n        requires_manual_review: true,\n        timestamp: new Date().toISOString(),\n        fallback_mode: true,\n        \n        // 🧱 给下游垫背，防止读取 .zh 或 .en 时报 undefined 崩溃\n        category_display: {\n            en: 'Error Review',\n            zh: '待人工审核'\n        },\n        summary: {\n            en: 'AI generation failed. Raw content preserved for manual review.',\n            zh: 'AI 摘要生成失败。原始文本已保留，等待人工排查。'\n        },\n        tags: []\n    }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1536,
        144
      ],
      "id": "af2e7c3f-a321-4157-ad81-d507255c0520",
      "name": "Handle AI Failure"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const rssData = $json;\n\n// 3. 验证必填字段\nif (!rssData.title || !rssData.url) {\n    throw new Error('Missing required RSS fields: title or url');\n}\n\n// 4. 初始化默认值\nlet analysisResult = {};\nlet sentiment = 'unknown';\nlet priority = 'low';\nlet categoryKey = 'uncategorized';\nlet aiSuccess = false;\n\n// 5. 验证 AI 响应并提取字段\nif (rssData && Object.keys(rssData).length > 0) {\n    try {\n        analysisResult = rssData;\n        \n        // 验证并标准化 sentiment\n        if (analysisResult.sentiment) {\n            const validSentiments = ['positive', 'negative', 'neutral'];\n            const lowerSentiment = analysisResult.sentiment.toLowerCase();\n            sentiment = validSentiments.includes(lowerSentiment) ? lowerSentiment : 'neutral';\n        }\n        \n        // 验证并标准化 priority\n        if (analysisResult.priority) {\n            const validPriorities = ['high', 'medium', 'low'];\n            const lowerPriority = analysisResult.priority.toLowerCase();\n            priority = validPriorities.includes(lowerPriority) ? lowerPriority : 'low';\n        }\n        \n        // 获取 category_key\n        if (analysisResult.category_key) {\n            categoryKey = String(analysisResult.category_key);\n        }\n        \n        aiSuccess = true;\n    } catch (validationError) {\n        // 验证失败，标记为需要人工审核\n        analysisResult = {\n            error: `Validation failed: ${validationError.message}`,\n            requires_manual_review: true,\n            original_response: rssData,\n            timestamp: new Date().toISOString()\n        };\n    }\n}\n\n// 6. 重新拼装吐给下游（数据库/通知）的完整合规数据\nreturn {\n    title: rssData.title,\n    content: rssData.content || '',\n    source_url: rssData.url,\n    ai_success: aiSuccess,\n    analysis_raw: {\n      'category_key' : analysisResult.category_key,\n      'category_display' : analysisResult.category_display,\n      'summary' : analysisResult.summary,\n      'sentiment' : analysisResult.sentiment,\n      'tags' : analysisResult.tags,\n      'priority' : analysisResult.priority,\n    }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
