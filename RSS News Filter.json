    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// 1. 获取当前进入 Discord 错误分支的单条失败数据\nconst failedItem = $json;\n\n// 2. 🧠 智能兼容处理：防御 n8n 将 error 变成纯字符串的隐藏 Bug\nlet errorMsg = 'Discord Webhook limit or connection error';\n\nif (failedItem.error) {\n    if (typeof failedItem.error === 'string') {\n        // 如果 error 本身就是字符串，直接拿来用\n        errorMsg = failedItem.error;\n    } else if (typeof failedItem.error === 'object') {\n        // 如果 error 是个对象，再安全地取它的 message 或 description\n        errorMsg = failedItem.error.message || failedItem.error.description || JSON.stringify(failedItem.error);\n    }\n}\n\n// 3. 直接返回平铺的对象\nreturn {\n    ...failedItem,\n    error_type: 'discord_notification_failed',\n    error_message: errorMsg,\n    failed_at: new Date().toISOString(),\n    \n    // 监控元数据\n    _metadata: {\n        processing_stage: 'discord_error_handled',\n        severity: 'low',\n        can_retry: true\n    }\n};"
      },
