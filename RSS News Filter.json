    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// 1. 获取当前进入 Telegram 错误分支的单条失败数据\n// 在 Run for Each Item 模式下，$json 直接就是当前这条失败数据的完整内容\nconst failedItem = $json;\n\n// 2. 尝试从前驱节点抓取真实的 Telegram 报错原因\n// n8n 节点报错进入 Error 分支时，通常会在数据里注入 error 对象\nconst errorMsg = failedItem.error?.message || 'Telegram API injection or network error';\n\n// 3. 直接返回平铺的对象，不要在外层套 json: {}\nreturn {\n    ...failedItem,\n    error_type: 'telegram_notification_failed',\n    error_message: errorMsg,\n    failed_at: new Date().toISOString(),\n    \n    // 监控元数据，方便下游的 Global Error Logger 汇总分类\n    _metadata: {\n        processing_stage: 'telegram_error_handled',\n        severity: 'low', // 通知失败属于低级或中级监控，不影响核心数据库\n        can_retry: true\n    }\n};"
      },
      "type": "n8n-nodes-base.code",
