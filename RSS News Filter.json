    {
      "parameters": {
        "jsCode": "const rssSources = $('Get Active RSS Sources').all();\n\nconst jsonRules = $('Load Classification Rules').all();\n\nconst notificationSettings = $('Load Notification Settings').all().length > 0 \n  ? $('Load Notification Settings').all()\n  : $('Handle Notification Config Load Error').all();\n\nreturn rssSources.map(rss => {\n  return {\n    json: {\n      // 把当前这一个 RSS 源的属性（id, name, feed_url）直接铺平放在最外层\n      ...rss.json, \n      // 把全量的分类规则和通知配置，作为该 Item 内部的子字典/数组随行携带\n      global_rules: jsonRules.map(r => r.json),\n      global_notifications: notificationSettings.map(n => n.json)\n    }\n  };\n});\n"
      },
