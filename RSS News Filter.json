    {
      "parameters": {
        "jsCode": "// 1. 安全抓取前驱节点的错误信息，防止极端情况下 $input.first() 报空指针\nlet errorMsg = 'Unknown error while loading database configuration';\n\ntry {\n    const firstInput = $input.first();\n    if (firstInput && firstInput.json && firstInput.json.error) {\n        errorMsg = firstInput.json.error.message || JSON.stringify(firstInput.json.error);\n    }\n} catch (e) {\n    console.log('Failed to parse upstream error:', e);\n}\n\nconsole.log('🚨 CRITICAL: Failed to load notification settings!', errorMsg);\n\n// 2. 💡 彻底去掉外部的 json: {} 包裹，改为直接平铺返回\n// 确保下游的 Check Notification Rules 节点能秒抓到这几个字段\nreturn {\n    _config_load_failed: true,\n    error_message: errorMsg,\n    fallback_settings: {\n        enabled_channels: [], // 关键：默认空数组，发生配置故障时不发任何通知，防止推流轰炸\n        notify_priorities: [],\n        rate_limit_per_hour: 0\n    }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -256,
        -352
      ],
      "id": "87acfbf5-d5bf-4b03-a1e5-a293434f02ec",
      "name": "Handle Notification Config Load Error"
    },
    {
      "parameters": {
        "jsCode": "// 1. 安全获取错误项\nconst errorItem = $input.first();\nlet errorDetails = {\n    name: 'Unknown Error',\n    message: 'No message provided',\n    node: 'Unknown node',\n    timestamp: new Date().toISOString(),\n    workflow_id: 'N/A'\n};\n\n// 2. 🧠 智能解析错误内容，防止 error 是纯字符串时引发崩溃\nif (errorItem && errorItem.json && errorItem.json.error) {\n    const upstreamError = errorItem.json.error;\n    \n    if (typeof upstreamError === 'string') {\n        errorDetails.message = upstreamError;\n    } else if (typeof upstreamError === 'object') {\n        errorDetails.name = upstreamError.name || 'Unknown';\n        errorDetails.message = upstreamError.message || 'No message';\n        errorDetails.node = upstreamError.nodeName || 'Unknown node';\n        errorDetails.workflow_id = upstreamError.workflowId || 'N/A';\n    }\n}\n\n// 3. 💡 彻底去掉外部的 json: {} 包裹，直接平铺返回\nreturn {\n    error_logged: true,\n    error_details: errorDetails,\n    _metadata: {\n        processing_stage: 'global_error_logged',\n        severity: 'low'\n    }\n};"
      },
